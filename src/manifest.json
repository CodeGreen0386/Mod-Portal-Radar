{
    "manifest_version": 3,
    "name": "Mod Portal Radar",
    "version": "1.1",
    "description": "Hide and tag Factorio mods with AI usage, powered by a community-maintained database.",
    "icons": {
        "32": "radar-32.png",
        "64": "radar-64.png"
    },

    "permissions": ["storage", "alarms"],

    "browser_specific_settings": {
        "gecko": {
            "id": "ModPortalRadar@github.com",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "background": {
        "service_worker": "background.js",
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": ["*://mods.factorio.com/*"],
            "js": ["radar.js"]
        }
    ]
}