{
    "manifest_version": 3,
    "name": "Mod Portal Radar",
    "version": "1.0",
    "description": "Tags or hides Factorio mods made with AI, using a community-maintained list.",
    "permissions": ["storage", "alarms"],

    "browser_specific_settings": {
        "gecko": {
            "id": "ModPortalRadar@mozilla.org",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["*://mods.factorio.com/*"],
            "js": ["radar.js"]
        }
    ]
}